{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-ai-os/plan/v1",
  "type": "object",
  "required": ["schemaVersion", "planId", "objectiveId", "revision", "state", "summary", "architectureDecisions", "assumptions", "clarificationNeeded", "clarificationQuestion", "projects", "nodes", "integration", "risk", "complexity", "approvedBy", "approvedAt", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "objectiveId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["PENDING_APPROVAL", "APPROVED", "SUPERSEDED", "CANCELLED"] },
    "summary": { "type": "string", "minLength": 1 },
    "architectureDecisions": { "type": "array" },
    "assumptions": { "type": "array" },
    "clarificationNeeded": { "type": "boolean" },
    "clarificationQuestion": { "type": ["string", "null"] },
    "projects": { "type": "array", "minItems": 1, "uniqueItems": true },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["skillId", "version", "checksum"],
              "properties": {
                "skillId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
                "version": { "type": "string", "minLength": 5 },
                "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    },
    "integration": { "type": "object" },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "complexity": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "approvedBy": { "type": ["string", "null"] },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
