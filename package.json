    "plan": "node src/orchestrator.mjs plan",
    "validate-task": "node src/orchestrator.mjs validate-task",
    "request-task": "node src/orchestrator.mjs request-task",
    "status": "node src/orchestrator.mjs status",
    "review": "node src/orchestrator.mjs review",
    "preview": "node src/orchestrator.mjs preview",
    "request-changes": "node src/orchestrator.mjs request-changes",
    "notifications": "node src/orchestrator.mjs notifications",
    "notification:read": "node src/orchestrator.mjs notification-read",
    "notification:test": "node src/orchestrator.mjs notification-test",
    "telemetry": "node src/orchestrator.mjs telemetry",
    "knowledge-health": "node src/orchestrator.mjs knowledge-health",
    "knowledge-candidates": "node src/orchestrator.mjs knowledge-candidates",
    "knowledge-review": "node src/orchestrator.mjs knowledge-review",
