{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-ai-os/objective/v1",
  "type": "object",
  "required": ["schemaVersion", "revision", "objectiveId", "mode", "state", "request", "requestedBy", "projectIds", "freshProject", "activePlanId", "activeOrchestrationId", "budget", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "objectiveId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["FRESH_PROJECT", "EXISTING_PROJECT", "CROSS_PROJECT_INCIDENT"] },
    "state": { "type": "string" },
    "request": { "type": "string", "minLength": 1 },
    "requestedBy": { "type": "string", "minLength": 1 },
    "projectIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "freshProject": { "type": ["object", "null"] },
    "activePlanId": { "type": ["string", "null"] },
    "activeOrchestrationId": { "type": ["string", "null"] },
    "budget": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
