{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-ai-os/skill/v1",
  "title": "Personal AI OS Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "skillId", "version", "purpose", "supportedRoles", "supportedTaskTypes", "requiredContextTypes", "requiredCapabilities", "compatibleProjectSignals", "riskLevel", "instructions", "verificationRequirements", "enabled", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ai-os-skill" },
    "skillId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "purpose": { "type": "string", "minLength": 1 },
    "supportedRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "supportedTaskTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredContextTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["context.read", "repository.read", "repository.write", "verification.run", "preview.read", "browser.capture", "knowledge.read", "knowledge.propose"] } },
    "compatibleProjectSignals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourcePath", "sha256"],
      "properties": {
        "resourcePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "verificationRequirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "enabled": { "type": "boolean" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "humanInstaller", "installedAt", "sourceRef"],
      "properties": {
        "source": { "enum": ["BUNDLED", "LOCAL_HUMAN"] },
        "humanInstaller": { "type": "string", "minLength": 1 },
        "installedAt": { "type": "string", "format": "date-time" },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
