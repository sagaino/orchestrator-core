# ==============================================================================
# AI OS v2 Supervised Local Pilot Configuration (LOCAL_PILOT Profile)
# ==============================================================================
# ⚠️ OPERATOR NOTICE:
# This file contains the opt-in configuration for supervised v2 local pilot operations.
# Copying these values into .env will enable objective intake, plan review autopilot,
# and registered cross-project diagnostics.
# Review the AI OS v2 threat model and scope before activating this profile.

ORCHESTRATOR_PROFILE=LOCAL_PILOT
ORCHESTRATOR_APPROVAL_MODE=PLAN_REVIEW_THEN_AUTOPILOT
ORCHESTRATOR_AUTO_FINALIZE_TASKS=0
ORCHESTRATOR_OBJECTIVES_ENABLED=1
ORCHESTRATOR_OBJECTIVE_SCHEDULER=1
ORCHESTRATOR_PARALLEL_OBJECTIVES=0
ORCHESTRATOR_SAME_PROJECT_PARALLEL=0
ORCHESTRATOR_CROSS_PROJECT=1
ORCHESTRATOR_TELEGRAM_ENABLED=0
ORCHESTRATOR_SKILLS_ENABLED=0
ORCHESTRATOR_SKILL_AUTO_ROUTING=0
ORCHESTRATOR_AUTO_RECOVERY_ATTEMPTS=2
ORCHESTRATOR_MAX_PARALLEL_JOBS=3

# Optional path and port overrides
# ORCHESTRATOR_VAULT_PATH=/path/to/vault
# ORCHESTRATOR_RUNS=/path/to/runs
# ORCHESTRATOR_API_PORT=3721
# ORCHESTRATOR_DASHBOARD_PORT=5173
