{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schemas/knowledge-provenance.schema.json",
  "title": "Personal AI OS Knowledge Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance_schema", "orchestrator_run", "sources", "confidence", "owner", "review_by", "supersession"],
  "properties": {
    "provenance_schema": { "const": 1 },
    "orchestrator_run": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "review_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "supersession": { "enum": ["ACTIVE", "SUPERSEDED", "RETIRED"] }
  }
}
