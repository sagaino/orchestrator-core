    "approve": "node src/orchestrator.mjs approve",
    "claim": "node src/orchestrator.mjs claim",
    "execute": "node src/orchestrator.mjs execute",
    "reject-review": "node src/orchestrator.mjs reject-review",
    "reject": "node src/orchestrator.mjs reject",
    "retrospect": "node src/orchestrator.mjs retrospect",
    "approve-knowledge": "node src/orchestrator.mjs approve-knowledge",
