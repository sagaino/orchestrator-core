{
  "name": "personal-ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Approval-gated orchestrator for the Obsidian Wiki and external projects.",
  "scripts": {
    "add-project": "node src/orchestrator.mjs add-project",
    "remove-project": "node src/orchestrator.mjs remove-project",
    "purge-project-archive": "node src/orchestrator.mjs purge-project-archive",
