{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-ai-os/orchestration/v1",
  "type": "object",
  "required": ["schemaVersion", "revision", "orchestrationId", "objectiveId", "planId", "state", "planFingerprint", "nodes", "integration", "usage", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "orchestrationId": { "type": "string", "minLength": 1 },
    "objectiveId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["CREATED", "RUNNING", "INTEGRATING", "BLOCKED", "DONE", "FAILED", "CANCELLED"] },
    "planFingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "nodes": { "type": "object", "minProperties": 1 },
    "integration": { "type": "object" },
    "usage": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
